APP_NAME=Rekrute
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses MySQL. Production (Vercel) uses Neon Postgres and sets
# DB_CONNECTION=pgsql plus DATABASE_URL instead of the individual DB_* values.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=projet_rekrute
DB_USERNAME=root
DB_PASSWORD=

# Neon connection string, e.g.
# postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/rekrute?sslmode=require
DATABASE_URL=

# Vercel Blob read-write token. Without it, uploads fall back to the local
# public disk, which is what you want in development.
BLOB_READ_WRITE_TOKEN=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
